<!-- 白天和黑夜主题 -->
<div class="stars-con">
    <div id="stars"></div>
    <div id="stars2"></div>
    <div id="stars3"></div>  
</div>

<script>
    function switchNightMode() {
        const targetMode = $('body').hasClass('DarkMode') ? 'light' : 'dark';
        const hasGiscus = typeof window.syncGiscusTheme === 'function';

        if (hasGiscus) {
            window.syncGiscusTheme(targetMode);
        }

        const applyNightMode = function () {
            if (targetMode === 'dark') {
                $('body').addClass('DarkMode');
                localStorage.setItem('isDark', '1');
                $('#sum-moon-icon').addClass('fa-sun').removeClass('fa-moon');
            } else {
                $('body').removeClass('DarkMode');
                localStorage.setItem('isDark', '0');
                $('#sum-moon-icon').removeClass('fa-sun').addClass('fa-moon');
            }

            if (hasGiscus) {
                window.syncGiscusTheme(targetMode);
            }
        };

        setTimeout(applyNightMode, hasGiscus ? 50 : 0);
    }
</script>
